# ============================================================
# Clautele: salin file ini ke .env lalu isi nilainya
#   cp .env.example .env
# JANGAN commit .env (sudah ada di .gitignore).
# ============================================================

# --- Telegram (WAJIB) ---------------------------------------
# Buat bot di @BotFather, salin token-nya ke sini.
TELEGRAM_BOT_TOKEN=

# Telegram user ID yang boleh memakai bot, pisahkan dengan koma.
# Dapatkan ID Anda dari @userinfobot atau kirim /id ke bot ini.
# WAJIB diisi: bot ini bisa menjalankan perintah di server Anda.
ALLOWED_USER_IDS=

# --- 2FA (TOTP, aplikasi authenticator) ------------------------
# WAJIB di mode host (tanpa Docker). Opsional di Docker, tapi disarankan.
# Buat secret di terminal PRIBADI (bukan di chat):  python -m clautele.totp
# lalu tambahkan ke aplikasi authenticator dan uji:  python -m clautele.totp --verify 123456
# Bot terkunci sampai Anda kirim  /login 123456 . Restart bot = terkunci lagi.
TOTP_SECRET=
# Lama sesi terbuka setelah login (menit, 1-1440)
TOTP_SESSION_MINUTES=60

# --- Autentikasi Claude Code (pilih SALAH SATU) ---------------
# A) API key Anthropic (paling mudah di server tanpa browser):
ANTHROPIC_API_KEY=
# B) Akun Claude (langganan): kosongkan ANTHROPIC_API_KEY, lalu salah satu:
#    - login di container:  docker compose run --rm clautele claude   (ketik /login)
#    - atau salin kredensial dari host:  cp ~/.claude/.credentials.json claude-config/
# Folder di HOST untuk config, kredensial, dan riwayat sesi Claude (mounted ke container).
# Buat dulu:  mkdir -p claude-config workspace   (harus bisa ditulis uid 1000)
CLAUDE_HOME_DIR=./claude-config

# --- Folder kerja ---------------------------------------------
# Folder di HOST yang bisa dibaca/ditulis Claude (dipasang ke /workspace di container).
WORKSPACE_DIR=./workspace

# --- Mode host (tanpa Docker, lihat deploy/install-host.sh) -----
# Folder kerja Claude saat bot dijalankan langsung di host. Di Docker nilai ini
# diabaikan (selalu /workspace). Kosong = ./workspace
# PERINGATAN: di mode host Claude punya akses sepenuh akun Linux Anda.
CLAUDE_WORKDIR=

# --- Perilaku Claude -------------------------------------------
# plan | acceptEdits | auto | dontAsk | bypassPermissions
# Bot berjalan tanpa terminal, jadi apa pun yang butuh izin otomatis DITOLAK,
# lalu bot menawarkan tombol "Izinkan". acceptEdits = edit file diizinkan.
CLAUDE_PERMISSION_MODE=acceptEdits

# bypassPermissions melewati semua pengecekan izin. Hanya aktifkan di sandbox
# yang Anda percaya, dan harus dikonfirmasi eksplisit di sini.
ALLOW_BYPASS_PERMISSIONS=false

# Tool yang selalu diizinkan, dipisah spasi (tanda kutip untuk pola dengan spasi).
# Contoh: Read Grep Glob "Bash(git status*)" "Bash(ls*)"
# Untuk video tanpa tombol izin: Read Grep Glob "Bash(ffmpeg *)" "Bash(ffprobe *)"
# (aturan Bash(x *) hanya mengizinkan perintah x; perintah berantai diperiksa per bagian)
CLAUDE_ALLOWED_TOOLS=Read Grep Glob

# Opsional: alias (sonnet/opus/haiku) atau nama model lengkap. Kosong = default.
CLAUDE_MODEL=

# Opsional: batas biaya per permintaan (USD), mis. 1.5
CLAUDE_MAX_BUDGET_USD=

# Batas waktu satu permintaan, dalam detik.
CLAUDE_TIMEOUT_SECONDS=900

# Opsional: instruksi tambahan untuk Claude.
CLAUDE_APPEND_SYSTEM_PROMPT=

# --- File dari/ke Telegram -------------------------------------
# Claude boleh mengirim file hasil kerjanya ke chat. Hanya file di dalam SEND_ROOTS;
# .env, kunci, dan kredensial selalu diblokir. Matikan dengan false.
SEND_FILES=true
# Folder yang boleh dikirim, pisahkan koma. Kosong = hanya <CLAUDE_WORKDIR>/.clautele/outbox
# (Claude diminta menyalin file ke sana). Hati-hati melebarkannya: file konfigurasi biasa
# (mis. docker-compose.yml berisi password) tidak bisa dikenali sebagai rahasia.
SEND_ROOTS=
# Batas ukuran kirim (maks 50) dan terima (maks 20), dalam MB (batas bot Telegram).
SEND_MAX_MB=50
UPLOAD_MAX_MB=20

# --- Suara / narasi (TTS) --------------------------------------
# Endpoint kompatibel OpenAI (POST /v1/audio/speech), mis. VoiceStudio yang berjalan di komputer Anda dan
# diakses lewat tunnel/VPN. Kosong = narasi dimatikan. Cek koneksi:
#   docker compose exec clautele python -m clautele.tts --probe
# WAJIB https:// (http hanya untuk localhost). Jangan taruh user:password di URL.
TTS_BASE_URL=
# Pilih SATU cara autentikasi (keduanya memakai header Authorization):
#   TTS_BASIC_AUTH=user:password   (mis. basic auth di tunnel ngrok)
#   TTS_API_KEY=kunci              (dikirim sebagai Bearer)
TTS_BASIC_AUTH=
TTS_API_KEY=
# Header tambahan, format "Nama: nilai; Nama2: nilai2" (opsional)
TTS_EXTRA_HEADERS=
# Nama suara (mis. suara kloning) dan model/engine; lihat hasil --probe
TTS_VOICE=default
TTS_MODEL=tts-1
TTS_FORMAT=wav
# Kode bahasa bila server memerlukannya, mis. id (opsional)
TTS_LANGUAGE=
TTS_TIMEOUT=120

# --- Tampilan di Telegram --------------------------------------
# Tampilkan tool yang sedang dipakai Claude secara langsung.
STREAM_PROGRESS=true
# Tampilkan juga cuplikan output tiap tool (bisa berisi data sensitif dari server).
SHOW_TOOL_OUTPUT=false
