# ============================================================
# Clautele: salin file ini ke .env lalu isi nilainya
#   cp .env.example .env
# JANGAN commit .env (sudah ada di .gitignore).
# ============================================================

# --- Telegram (WAJIB) ---------------------------------------
# Buat bot di @BotFather, salin token-nya ke sini.
TELEGRAM_BOT_TOKEN=

# Telegram user ID yang boleh memakai bot, pisahkan dengan koma.
# Dapatkan ID Anda dari @userinfobot atau kirim /id ke bot ini.
# WAJIB diisi: bot ini bisa menjalankan perintah di server Anda.
ALLOWED_USER_IDS=

# --- Autentikasi Claude Code (pilih SALAH SATU) ---------------
# A) API key Anthropic (paling mudah di server tanpa browser):
ANTHROPIC_API_KEY=
# B) Akun Claude (langganan): kosongkan ANTHROPIC_API_KEY, lalu salah satu:
#    - login di container:  docker compose run --rm clautele claude   (ketik /login)
#    - atau salin kredensial dari host:  cp ~/.claude/.credentials.json claude-config/
# Folder di HOST untuk config, kredensial, dan riwayat sesi Claude (mounted ke container).
# Buat dulu:  mkdir -p claude-config workspace   (harus bisa ditulis uid 1000)
CLAUDE_HOME_DIR=./claude-config

# --- Folder kerja ---------------------------------------------
# Folder di HOST yang bisa dibaca/ditulis Claude (dipasang ke /workspace di container).
WORKSPACE_DIR=./workspace

# --- Perilaku Claude -------------------------------------------
# plan | acceptEdits | auto | dontAsk | bypassPermissions
# Bot berjalan tanpa terminal, jadi apa pun yang butuh izin otomatis DITOLAK,
# lalu bot menawarkan tombol "Izinkan". acceptEdits = edit file diizinkan.
CLAUDE_PERMISSION_MODE=acceptEdits

# bypassPermissions melewati semua pengecekan izin. Hanya aktifkan di sandbox
# yang Anda percaya, dan harus dikonfirmasi eksplisit di sini.
ALLOW_BYPASS_PERMISSIONS=false

# Tool yang selalu diizinkan, dipisah spasi (tanda kutip untuk pola dengan spasi).
# Contoh: Read Grep Glob "Bash(git status*)" "Bash(ls*)"
CLAUDE_ALLOWED_TOOLS=Read Grep Glob

# Opsional: alias (sonnet/opus/haiku) atau nama model lengkap. Kosong = default.
CLAUDE_MODEL=

# Opsional: batas biaya per permintaan (USD), mis. 1.5
CLAUDE_MAX_BUDGET_USD=

# Batas waktu satu permintaan, dalam detik.
CLAUDE_TIMEOUT_SECONDS=900

# Opsional: instruksi tambahan untuk Claude.
CLAUDE_APPEND_SYSTEM_PROMPT=

# --- Tampilan di Telegram --------------------------------------
# Tampilkan tool yang sedang dipakai Claude secara langsung.
STREAM_PROGRESS=true
# Tampilkan juga cuplikan output tiap tool (bisa berisi data sensitif dari server).
SHOW_TOOL_OUTPUT=false
